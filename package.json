{
  "name": "flashkit-monorepo",
  "version": "0.1.1",
  "private": true,
  "description": "FlashKit for GIWA — Developer toolkit for instant onchain transaction experiences",
  "author": "FlashKit Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufky63/giwa-flashkit.git"
  },
  "bugs": {
    "url": "https://github.com/yusufky63/giwa-flashkit/issues"
  },
  "homepage": "https://github.com/yusufky63/giwa-flashkit#readme",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:live": "tsx scripts/health-check.ts",
    "test:live:write": "tsx scripts/proof.ts",
    "test:proof": "tsx scripts/proof.ts",
    "test:onchain": "tsx scripts/test-live-tx.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:smoke": "tsx scripts/benchmark.ts --smoke",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "release": "pnpm -r publish --access public --no-git-checks"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3",
    "viem": "^2.56.7",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "22.x"
  }
}
