{
  "name": "@flashkit/core",
  "version": "0.1.1",
  "description": "Core transaction lifecycle, preconfirmation and simulation engine for GIWA Flashblocks",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "viem": ">=2.20.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "viem": "^2.56.7",
    "vitest": "^3.0.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufky63/giwa-flashkit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/yusufky63/giwa-flashkit/issues"
  },
  "homepage": "https://github.com/yusufky63/giwa-flashkit#readme",
  "license": "MIT"
}
