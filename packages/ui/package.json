{
  "name": "@flashkit/ui",
  "version": "0.1.1",
  "description": "Developer UI components for GIWA Flashblocks transaction telemetry & timeline",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@flashkit/core": "workspace:*",
    "@flashkit/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "viem": ">=2.20.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "react": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "viem": "^2.56.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufky63/giwa-flashkit.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/yusufky63/giwa-flashkit/issues"
  },
  "homepage": "https://github.com/yusufky63/giwa-flashkit#readme",
  "license": "MIT"
}
